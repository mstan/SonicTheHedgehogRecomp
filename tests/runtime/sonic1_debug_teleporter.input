# Sonic 1 JUE REV00: first SBZ2 teleporter, debug-flight capture regression.
# Run with --input-script and a fresh profile. Positioning is test setup;
# the original teleporter object, debug exit and right input run normally.
WAIT 600
PRESS UP 2
WAIT 4
PRESS DOWN 2
WAIT 4
PRESS LEFT 2
WAIT 4
PRESS RIGHT 2
WAIT 4
ASSERT_RAM8 0xFFFFE0 1
HOLD A
PRESS START 2
WAIT 30
RELEASE
WAIT 30
WRITE_RAM16 0xFFFF82 0x10
PRESS START 2
WAIT 400
ASSERT_RAM16 0xFFFE10 0x501
WRITE_RAM8 0xFFFFE1 1
WRITE_RAM16 0xFFD008 0x94
WRITE_RAM16 0xFFD00C 0x190
WRITE_RAM16 0xFFFE08 1
WAIT 3
ASSERT_RAM8 0xFFF7C8 0
HOLD RIGHT
WAIT 1
WRITE_RAM8 0xFFFE0A 1
WRITE_RAM8 0xFFFE0B 0xFF
WAIT 70
RELEASE
ASSERT_RAM8 0xFFF7C8 0
PRESS B 2
WAIT 5
ASSERT_RAM16 0xFFFE08 0
ASSERT_RAM8 0xFFF7C8 0
HOLD RIGHT
WAIT 30
RELEASE
ASSERT_RAM8 0xFFF7C8 0
EXIT 0
